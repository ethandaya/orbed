#!/usr/bin/env bash
set -euo pipefail

started_at=$SECONDS
echo "[orb setup] checking Node.js"
node_major=$(node --version | sed -E 's/^v([0-9]+).*/\1/')
if (( node_major < 22 )); then
  echo "[orb setup] Node.js 22 or newer is required; found $(node --version)" >&2
  exit 1
fi

echo "[orb setup] installing locked npm dependencies"
npm ci --ignore-scripts

echo "[orb setup] building TypeScript"
npm run build

echo "[orb setup] complete in $((SECONDS - started_at))s"
