{
  "name": "orbed",
  "version": "0.0.1",
  "description": "Prompt-driven portal tests executed by Amp agents",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ethandaya/orbed.git"
  },
  "homepage": "https://github.com/ethandaya/orbed#readme",
  "bugs": "https://github.com/ethandaya/orbed/issues",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc && tsc -p tsconfig.tests.json",
    "test": "bun test ./tests/*.test.ts",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish",
    "prepack": "npm run build"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@ampcode/plugin": "0.0.0-20260923001649-g009f5d9"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/bun": "^1.4.2",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3"
  }
}
