{
  "name": "orbed",
  "version": "0.0.1",
  "description": "Prompt-driven portal tests executed by Amp agents",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc && tsc -p tsconfig.tests.json",
    "test": "bun test ./tests/*.test.ts",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@ampcode/plugin": "0.0.0-20260923001649-g009f5d9"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3"
  }
}
